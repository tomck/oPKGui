{
   "webservice": {
      "services": [
         {
            "service": "opkgui",
            "display_name": "oPKGui",
            "icon": "app/images/opkgui-{0}.png",
            "type": "apache_php",
            "root": "opkgui",
            "backend": 2,
            "php": {
               "profile_name": "oPKGui PHP Profile",
               "profile_desc": "PHP profile for oPKGui",
               "backend": 11,
               "extensions": [],
               "user": "sc-opkgui",
               "group": "http"
            }
         }
      ],
      "portals": [
         {
            "service": "opkgui",
            "type": "server",
            "name": "oPKGui",
            "http_port": [18890],
            "app": "com.github.tomkoch.opkgui"
         }
      ],
      "pkg_dir_prepare": [
         {
            "source": "/var/packages/opkgui/target/web/opkgui",
            "target": "opkgui",
            "mode": "0755",
            "user": "sc-opkgui",
            "group": "http"
         }
      ]
   }
}
